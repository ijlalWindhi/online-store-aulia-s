---
import Layout from '../layouts/Layout.astro';
import Home from '../views/Home.astro';
import About from '../views/About.astro';
import Services from '../views/Services.astro';
import Dashboard from '../views/Dashboard.astro';
import Portfolio from '../views/Portfolio.astro';
import CustomerExperience from '../views/CustomerExperience.astro';
import BrandExperience from '../views/BrandExperience.astro';
import Contact from '../views/Contact.astro';
import { langs, routes, type Lang, type PageKey } from '../data/site.ts';

// Every Indonesian and English route comes from the single route map in site.ts.
export function getStaticPaths() {
	return (Object.keys(routes) as PageKey[]).flatMap((page) =>
		langs.map((lang) => ({
			params: { path: routes[page][lang].replace(/^\/|\/$/g, '') || undefined },
			props: { page, lang },
		})),
	);
}

const views = {
	home: Home,
	about: About,
	services: Services,
	dashboard: Dashboard,
	portfolio: Portfolio,
	customerExperience: CustomerExperience,
	brandExperience: BrandExperience,
	contact: Contact,
};

const { page, lang } = Astro.props as { page: PageKey; lang: Lang };
const View = views[page];
---

<Layout lang={lang} page={page}>
	<View lang={lang} />
</Layout>
