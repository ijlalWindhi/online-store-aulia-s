---
import { routes, ui, type Lang } from '../data/site.ts';
import type { Service } from '../data/services.ts';

interface Props {
	lang: Lang;
	services: Service[];
}

const { lang, services } = Astro.props;
---

<ul class="price-list">
	{
		services.map((service) => (
			<li class="row">
				<a class="name" href={`${routes.services[lang]}#${service.slug}`}>
					{service.name[lang]}
				</a>
				<span class="leader" aria-hidden="true" />
				<span class="price">
					<span class="muted-text">{`${ui.from[lang]} `}</span>
					{service.startingPrice}
					{service.priceUnit && <span class="muted-text">{` ${service.priceUnit[lang]}`}</span>}
				</span>
				<span class="time">{`${ui.turnaround[lang]} ${service.turnaround[lang]}`}</span>
			</li>
		))
	}
</ul>

<style>
	.price-list {
		border-top: 2px solid var(--charcoal);
		list-style: none;
	}

	.row {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		padding-block: 0.625rem 1rem;
		border-bottom: 1px solid var(--rule);
	}

	.name {
		justify-self: start;
		padding-block: 0.5rem;
		font-family: var(--heading);
		font-size: var(--text-lg);
		line-height: 1.25;
		text-decoration: none;
	}

	.name:hover {
		text-decoration: underline;
		text-decoration-thickness: 1px;
	}

	.leader {
		display: none;
	}

	.price {
		font-weight: 600;
		font-variant-numeric: tabular-nums;
		white-space: pre-wrap;
	}

	.muted-text,
	.time {
		color: var(--muted);
		font-weight: 400;
	}

	.time {
		font-size: var(--text-sm);
	}

	/* Wider screens read like a shop price board: name, dotted leader, price. */
	@media (min-width: 40rem) {
		.row {
			grid-template-columns: auto minmax(2rem, 1fr) auto;
			align-items: baseline;
			column-gap: 0.75rem;
		}

		.leader {
			display: block;
			border-bottom: 2px dotted var(--rule);
		}

		.price {
			text-align: right;
			white-space: nowrap;
		}

		.time {
			grid-column: 1 / -1;
		}
	}
</style>
