---
import { Font } from 'astro:assets';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { brand, langs, routes, ui, type Lang, type PageKey } from '../data/site.ts';
import { meta, ogImageAlt } from '../data/content.ts';

interface Props {
	lang: Lang;
	/** Omit for pages outside the route map (404). They get no canonical, no hreflang, and noindex. */
	page?: PageKey;
	title?: string;
	description?: string;
}

const { lang, page } = Astro.props;
const title = page ? meta[page].title[lang] : Astro.props.title;
const description = page ? meta[page].description[lang] : Astro.props.description;
const site = Astro.site!;
const url = (path: string) => new URL(path, site).href;
const canonical = page && url(routes[page][lang]);
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		{
			page ? (
				<>
					<link rel="canonical" href={canonical} />
					{langs.map((l) => <link rel="alternate" hreflang={l} href={url(routes[page][l])} />)}
					<link rel="alternate" hreflang="x-default" href={url(routes[page].id)} />
				</>
			) : (
				<meta name="robots" content="noindex" />
			)
		}
		<link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="theme-color" content="#F6F0E7" />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={brand} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{canonical && <meta property="og:url" content={canonical} />}
		<meta property="og:locale" content={lang === 'id' ? 'id_ID' : 'en_US'} />
		<meta property="og:locale:alternate" content={lang === 'id' ? 'en_US' : 'id_ID'} />
		<meta property="og:image" content={url('/og.png')} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={ogImageAlt[lang]} />
		<meta name="twitter:card" content="summary_large_image" />
		<Font cssVariable="--font-heading" preload />
		<Font cssVariable="--font-body" preload />
		<Font cssVariable="--font-dian" />
		<script is:inline>document.documentElement.classList.add('js');</script>
	</head>
	<body>
		<a class="skip-link" href="#main">{ui.skip[lang]}</a>
		<Header lang={lang} page={page} />
		<main id="main" tabindex="-1">
			<slot />
		</main>
		<Footer lang={lang} />
	</body>
</html>
