---
import { ui, type Lang } from '../data/site.ts';
import { portfolioPage, projects } from '../data/content.ts';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
---

<div class="wrap page-head">
	<h1>{portfolioPage.title[lang]}</h1>
	<p class="lead">{portfolioPage.intro[lang]}</p>
</div>

{
	projects.map((project, i) => (
		<article id={project.slug} class:list={['wrap block project', { flip: i % 2 === 1 }]} aria-labelledby={`${project.slug}-title`}>
			<div class="head">
				<span class="concept-label">{ui.conceptProject[lang]}</span>
				<h2 id={`${project.slug}-title`}>{project.name}</h2>
				<p class="summary">{project.summary[lang]}</p>
			</div>
			<figure class="visual">
				<img
					src={project.image.src}
					width={project.image.width}
					height={project.image.height}
					alt={project.image.alt[lang]}
					loading={i === 0 ? 'eager' : 'lazy'}
					decoding="async"
				/>
				<figcaption>
					<strong>
						{ui.conceptProject[lang]}. {portfolioPage.result[lang]}:
					</strong>{' '}
					{project.result[lang]} {portfolioPage.notClient[lang]}
				</figcaption>
			</figure>
			<dl class="details">
				<div>
					<dt>{portfolioPage.workType[lang]}</dt>
					<dd>{project.work[lang]}</dd>
				</div>
				<div>
					<dt>{portfolioPage.goal[lang]}</dt>
					<dd>{project.goal[lang]}</dd>
				</div>
				<div>
					<dt>{portfolioPage.process[lang]}</dt>
					<dd>
						<ol class="steps">
							{project.process.map((step) => <li>{step[lang]}</li>)}
						</ol>
					</dd>
				</div>
			</dl>
		</article>
	))
}

<style>
	.project {
		display: grid;
		gap: 1.5rem 3.5rem;
		padding-top: 2.5rem;
		border-top: 2px solid var(--charcoal);
	}

	.head h2 {
		margin-top: 0.875rem;
		font-size: var(--text-2xl);
	}

	.summary {
		max-width: var(--measure);
		margin-top: 0.5rem;
		font-size: var(--text-md);
	}

	.visual img {
		width: 100%;
		aspect-ratio: 4 / 3;
		border: 1px solid var(--rule);
		background: var(--paper);
	}

	figcaption {
		margin-top: 0.75rem;
		color: var(--muted);
		font-size: var(--text-sm);
	}

	figcaption strong {
		color: var(--charcoal);
	}

	.details > div + div {
		margin-top: 1.5rem;
	}

	.details dt {
		font-family: var(--heading);
		font-size: var(--text-md);
	}

	.details dd {
		margin-top: 0.375rem;
	}

	.details .steps li {
		padding-left: 2.25rem;
	}

	.details .steps li + li {
		margin-top: 0.75rem;
	}

	.details .steps li::before {
		top: -0.15em;
		font-size: var(--text-md);
	}

	@media (min-width: 60rem) {
		.project {
			grid-template-columns: 7fr 5fr;
			align-items: start;
		}

		.head {
			grid-column: 1 / -1;
		}

		.flip {
			grid-template-columns: 5fr 7fr;
		}

		.flip .visual {
			order: 2;
		}
	}
</style>
