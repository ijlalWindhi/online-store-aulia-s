---
import { routes, type Lang } from '../data/site.ts';
import { brandExperience as bx } from '../data/content.ts';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const { sensory, affective, intellectual, behavioral } = bx;
const samples: Record<string, { text: string; font: string }> = {
	Newsreader: { text: 'Aa', font: 'var(--font-heading)' },
	'Source Sans 3': { text: 'Aa', font: 'var(--font-body)' },
	'Noto Serif SC': { text: '店', font: 'var(--font-dian), serif' },
};
---

<div class="wrap page-head">
	<h1>{bx.title[lang]}</h1>
	<p class="lead">{bx.intro[lang]}</p>
</div>

<section class="wrap block dimension" aria-labelledby="sensory-title">
	<div class="split">
		<h2 id="sensory-title">{sensory.heading[lang]}</h2>
		<p class="prose">{sensory.text[lang]}</p>
	</div>
	<div class="specimens">
		<ul class="colors">
			{
				sensory.colors.map((color) => (
					<li>
						<span class="chip" style={`background-color: ${color.hex}`} />
						<span class="color-name">{color.name[lang]}</span>
						<span class="muted">{color.hex}</span>
					</li>
				))
			}
		</ul>
		<ul class="type">
			{
				sensory.type.map((item) => (
					<li>
						<span class="sample" style={`font-family: ${samples[item.family].font}`} aria-hidden="true">
							{samples[item.family].text}
						</span>
						<span class="color-name">{item.family}</span>
						<span class="muted">{item.role[lang]}</span>
					</li>
				))
			}
		</ul>
	</div>
</section>

{
	[affective, intellectual].map((dimension, i) => (
		<section class="wrap block dimension split" aria-labelledby={`dimension-${i}`}>
			<h2 id={`dimension-${i}`}>{dimension.heading[lang]}</h2>
			<div class="prose">
				<p>{dimension.text[lang]}</p>
				<h3 class="applied">{bx.applied[lang]}</h3>
				<ul class="bullets">
					{dimension.points.map((point) => (
						<li>{point[lang]}</li>
					))}
				</ul>
			</div>
		</section>
	))
}

<section class="wrap block dimension split" aria-labelledby="behavioral-title">
	<h2 id="behavioral-title">{behavioral.heading[lang]}</h2>
	<div class="prose">
		<p>{behavioral.text[lang]}</p>
		<h3 class="applied">{bx.applied[lang]}</h3>
		<ol class="steps path">
			{
				behavioral.steps.map((step) => (
					<li>
						<a class="text-link" href={routes[step.page][lang]}>
							{step.label[lang]}
						</a>
					</li>
				))
			}
		</ol>
	</div>
</section>

<style>
	.dimension {
		padding-top: 2.5rem;
		border-top: 2px solid var(--charcoal);
	}

	.applied {
		margin-top: 1.75rem;
	}

	.specimens {
		display: grid;
		gap: 2rem 4rem;
		margin-top: 2.5rem;
	}

	.colors,
	.type {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 8rem), 1fr));
		gap: 1.5rem;
		list-style: none;
	}

	.colors li,
	.type li {
		display: grid;
		align-content: start;
	}

	.chip {
		height: 4.5rem;
		margin-bottom: 0.625rem;
		border: 1px solid var(--rule);
	}

	.sample {
		margin-bottom: 0.25rem;
		font-size: 3.5rem;
		font-weight: 500;
		line-height: 1.1;
	}

	.color-name {
		font-weight: 600;
	}

	.path {
		margin-top: 0.5rem;
	}

	.path li::before {
		top: 0.35rem;
	}

	@media (min-width: 60rem) {
		.specimens {
			grid-template-columns: 7fr 5fr;
		}
	}
</style>
