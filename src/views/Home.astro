---
import ServiceSummary from '../components/ServiceSummary.astro';
import { routes, ui, whatsappUrl, type Lang } from '../data/site.ts';
import { featuredSlugs, processSteps, services } from '../data/services.ts';
import { home, projects } from '../data/content.ts';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const featured = services.filter((service) => featuredSlugs.includes(service.slug));
---

<section class="wrap hero" aria-labelledby="hero-title">
	<h1 id="hero-title" class="hero-title">{ui.tagline[lang]}</h1>
	<div class="hero-body">
		<p class="hero-intro">{home.intro[lang]}</p>
		<div class="actions hero-actions">
			<a class="button button-primary" href={routes.services[lang]}>{home.seeServices[lang]}</a>
			<a class="button" href={whatsappUrl(lang)}>{ui.consult[lang]}</a>
		</div>
		<p class="muted audience">{home.audience[lang]}</p>
	</div>
</section>

<section class="wrap block split" aria-labelledby="featured-title">
	<div>
		<h2 id="featured-title">{home.featured.heading[lang]}</h2>
		<p class="featured-intro">{home.featured.intro[lang]}</p>
		<a class="text-link" href={routes.customerExperience[lang]}>{home.featured.interviewLink[lang]}</a>
	</div>
	<div>
		<ServiceSummary lang={lang} services={featured} />
		<p class="more">{home.featured.more[lang]}</p>
		<a class="text-link" href={routes.services[lang]}>{home.featured.moreLink[lang]}</a>
	</div>
</section>

<section class="wrap block" aria-labelledby="reasons-title">
	<h2 id="reasons-title">{home.reasons.heading[lang]}</h2>
	<ul class="reasons">
		{
			home.reasons.items.map((item) => (
				<li>
					<h3>{item.title[lang]}</h3>
					<p>{item.text[lang]}</p>
				</li>
			))
		}
	</ul>
</section>

<section class="wrap block" aria-labelledby="projects-title">
	<div class="split">
		<h2 id="projects-title">{home.projects.heading[lang]}</h2>
		<p class="prose">{home.projects.intro[lang]}</p>
	</div>
	<ul class="projects">
		{
			projects.map((project) => (
				<li class="project">
					<img
						src={project.image.src}
						width={project.image.width}
						height={project.image.height}
						alt={project.image.alt[lang]}
						loading="lazy"
						decoding="async"
					/>
					<div class="project-text">
						<span class="concept-label">{ui.conceptProject[lang]}</span>
						<h3>{project.name}</h3>
						<p class="muted">{project.work[lang]}</p>
						<a class="text-link" href={`${routes.portfolio[lang]}#${project.slug}`}>
							{home.projects.link[lang]}
							<span class="visually-hidden">: {project.name}</span>
						</a>
					</div>
				</li>
			))
		}
	</ul>
</section>

<section class="wrap block" aria-labelledby="process-title">
	<h2 id="process-title">{home.process.heading[lang]}</h2>
	<ol class="steps process">
		{processSteps.map((step) => <li>{step[lang]}</li>)}
	</ol>
</section>

<section class="band" aria-labelledby="cta-title">
	<div class="wrap">
		<h2 id="cta-title" class="cta-title">{home.cta.heading[lang]}</h2>
		<p class="cta-text">{home.cta.text[lang]}</p>
		<div class="actions cta-actions">
			<a class="button button-primary" href={whatsappUrl(lang)}>{ui.consult[lang]}</a>
			<a class="text-link" href={routes.contact[lang]}>{home.cta.contactLink[lang]}</a>
		</div>
	</div>
</section>

<style>
	.hero {
		padding-top: clamp(3rem, 1.5rem + 6vw, 7rem);
	}

	.hero-title {
		max-width: 13ch;
		font-size: var(--text-hero);
		line-height: 1.02;
		letter-spacing: -0.03em;
	}

	.hero-body {
		max-width: var(--measure);
		margin-top: clamp(1.5rem, 1rem + 2vw, 2.75rem);
	}

	.hero-intro {
		font-size: var(--text-md);
		line-height: 1.55;
	}

	.hero-actions {
		margin-top: 2rem;
	}

	.audience {
		margin-top: 1.25rem;
	}

	@media (min-width: 60rem) {
		.hero-body {
			margin-left: 41.666%;
		}
	}

	.featured-intro {
		margin-top: 1rem;
		max-width: 26rem;
	}

	.more {
		margin-top: 1.5rem;
	}

	.reasons {
		display: grid;
		gap: 2rem 3rem;
		margin-top: 2rem;
		list-style: none;
	}

	.reasons li {
		padding-top: 1rem;
		border-top: 2px solid var(--charcoal);
	}

	.reasons p {
		max-width: 32rem;
		margin-top: 0.5rem;
	}

	@media (min-width: 44rem) {
		.reasons {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	.projects {
		display: grid;
		gap: 3rem;
		margin-top: 2.5rem;
		list-style: none;
	}

	.project img {
		width: 100%;
		aspect-ratio: 4 / 3;
		border: 1px solid var(--rule);
		background: var(--paper);
	}

	.project-text {
		margin-top: 1rem;
	}

	.project h3 {
		margin-top: 0.75rem;
		font-size: var(--text-lg);
	}

	.project p {
		margin-top: 0.25rem;
	}

	@media (min-width: 48rem) {
		.projects {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			column-gap: 2rem;
		}

		.project:first-child {
			grid-column: 1 / -1;
		}
	}

	@media (min-width: 68rem) {
		.projects {
			grid-template-columns: 7fr 4fr;
			column-gap: 3rem;
		}

		.project:first-child {
			grid-column: 1;
			grid-row: 1 / span 2;
		}
	}

	.process {
		display: grid;
		gap: 1.5rem 2.5rem;
		margin-top: 2rem;
	}

	.process li {
		padding-top: 1rem;
		border-top: 1px solid var(--rule);
	}

	.process li::before {
		top: 0.75rem;
	}

	@media (min-width: 44rem) {
		.process {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (min-width: 68rem) {
		.process {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}

	.cta-title {
		max-width: 20ch;
		font-size: var(--text-2xl);
	}

	.cta-text {
		max-width: var(--measure);
		margin-top: 1rem;
	}

	.cta-actions {
		margin-top: 2rem;
	}
</style>
