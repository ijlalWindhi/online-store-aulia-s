---
import { routes, ui, whatsappUrl, type Lang } from '../data/site.ts';
import { processSteps, services, type Service } from '../data/services.ts';
import { dashboardPage, home } from '../data/content.ts';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;

const maxPrice = Math.max(...services.map((service) => service.startingPriceValue));
const maxDays = Math.max(...services.map((service) => service.turnaroundDays.max));
const percent = (part: number, whole: number) => `${((part / whole) * 100).toFixed(2)}%`;
/** Same price string the Services page sends, so both pages open one identical WhatsApp message. */
const orderPrice = (service: Service) => (service.priceUnit ? `${service.startingPrice} ${service.priceUnit[lang]}` : service.startingPrice);
const total = services.length;
const initialCount = dashboardPage.count.other[lang].replace('{n}', String(total)).replace('{total}', String(total));
---

<div class="wrap page-head">
	<p class="eyebrow">{dashboardPage.eyebrow[lang]}</p>
	<h1>{dashboardPage.title[lang]}</h1>
	<p class="lead">{dashboardPage.intro[lang]}</p>
</div>

<div class="wrap block">
	<!-- Hidden until the script below attaches its listeners, so a filter is never visible while inert. -->
	<fieldset id="dashboard-filters" class="filters" hidden>
		<legend class="filters-legend">{dashboardPage.filterHeading[lang]}</legend>
		<p class="field">
			<label for="filter-category">{dashboardPage.categoryLabel[lang]}</label>
			<select id="filter-category" name="category">
				<option value="all">{dashboardPage.categories.all[lang]}</option>
				<option value="graphic-design">{dashboardPage.categories['graphic-design'][lang]}</option>
				<option value="ui-ux">{dashboardPage.categories['ui-ux'][lang]}</option>
				<option value="website">{dashboardPage.categories.website[lang]}</option>
			</select>
		</p>
		<p class="field">
			<label for="filter-budget">{dashboardPage.budgetLabel[lang]}</label>
			<select id="filter-budget" name="budget">
				<option value="">{dashboardPage.budgetAll[lang]}</option>
				{dashboardPage.budgetOptions.map((option) => <option value={option.value}>{option.label[lang]}</option>)}
			</select>
		</p>
	</fieldset>

	<p
		id="dashboard-count"
		class="count"
		aria-live="polite"
		data-one={dashboardPage.count.one[lang]}
		data-other={dashboardPage.count.other[lang]}
		data-total={total}
	>
		{initialCount}
	</p>

	<div class="figures">
		<figure class="figure" aria-labelledby="price-figure-title">
			<figcaption>
				<h2 id="price-figure-title">{dashboardPage.priceFigure.title[lang]}</h2>
				<p class="muted figure-note">{dashboardPage.priceFigure.text[lang]}</p>
			</figcaption>
			<ul class="bars">
				{
					services.map((service) => (
						<li class="bar-row" data-service={service.slug} data-category={service.category} data-price={service.startingPriceValue}>
							<span class="bar-name">{service.name[lang]}</span>
							<span class="bar-track" aria-hidden="true">
								<span class="bar-fill bar-price" style={`width:${percent(service.startingPriceValue, maxPrice)}`} />
							</span>
							<span class="bar-value">{service.startingPrice}</span>
						</li>
					))
				}
			</ul>
		</figure>

		<figure class="figure" aria-labelledby="turnaround-figure-title">
			<figcaption>
				<h2 id="turnaround-figure-title">{dashboardPage.turnaroundFigure.title[lang]}</h2>
				<p class="muted figure-note">{dashboardPage.turnaroundFigure.text[lang]}</p>
			</figcaption>
			<ul class="bars">
				{
					services.map((service) => (
						<li class="bar-row" data-service={service.slug} data-category={service.category} data-price={service.startingPriceValue}>
							<span class="bar-name">{service.name[lang]}</span>
							<span class="bar-track" aria-hidden="true">
								<span
									class="bar-fill bar-days"
									style={`margin-inline-start:${percent(service.turnaroundDays.min - 1, maxDays)};width:${percent(service.turnaroundDays.max - service.turnaroundDays.min + 1, maxDays)}`}
								/>
							</span>
							<span class="bar-value">{service.turnaround[lang]}</span>
						</li>
					))
				}
			</ul>
		</figure>
	</div>
</div>

<section class="wrap block" aria-labelledby="ledger-title">
	<h2 id="ledger-title" class="ledger-title">{dashboardPage.ledger.title[lang]}</h2>
	<ul class="ledger">
		{
			services.map((service) => (
				<li class="ledger-row" data-service={service.slug} data-category={service.category} data-price={service.startingPriceValue}>
					<div class="ledger-head">
						<h3>
							<a href={`${routes.services[lang]}#${service.slug}`}>{service.name[lang]}</a>
						</h3>
						<p class="category">{dashboardPage.categories[service.category][lang]}</p>
					</div>
					<dl class="ledger-facts">
						<div>
							<dt>{ui.startingPrice[lang]}</dt>
							<dd class="fact-price">
								{service.startingPrice}
								{service.priceUnit && <span class="muted"> {service.priceUnit[lang]}</span>}
							</dd>
						</div>
						<div>
							<dt>{ui.turnaround[lang]}</dt>
							<dd>{service.turnaround[lang]}</dd>
						</div>
						<div>
							<dt>{ui.revisions[lang]}</dt>
							<dd>{service.revisions[lang]}</dd>
						</div>
					</dl>
					<details class="ledger-details">
						<summary>{dashboardPage.ledger.details[lang]}</summary>
						<div class="details-body">
							<div>
								<h4>{ui.scope[lang]}</h4>
								<ul class="bullets">
									{service.scope.map((item) => (
										<li>{item[lang]}</li>
									))}
								</ul>
							</div>
							<div>
								<h4>{ui.deliverables[lang]}</h4>
								<ul class="bullets">
									{service.deliverables.map((item) => (
										<li>{item[lang]}</li>
									))}
								</ul>
							</div>
						</div>
					</details>
					<a class="button button-primary ledger-cta" href={whatsappUrl(lang, { service: service.name[lang], price: orderPrice(service) })}>
						{ui.order[lang]}
						<span class="visually-hidden">: {service.name[lang]}</span>
					</a>
				</li>
			))
		}
	</ul>

	<div id="dashboard-empty" class="empty" hidden>
		<h3>{dashboardPage.empty.title[lang]}</h3>
		<p class="prose">{dashboardPage.empty.text[lang]}</p>
		<div class="actions">
			<button id="dashboard-reset" class="button" type="button">{dashboardPage.empty.reset[lang]}</button>
			<a class="text-link" href={whatsappUrl(lang)}>{ui.consult[lang]}</a>
		</div>
	</div>

	<p class="services-link">
		<a class="text-link" href={routes.services[lang]}>{dashboardPage.ledger.servicesLink[lang]}</a>
	</p>
</section>

<section class="band" aria-labelledby="flow-title">
	<div class="wrap">
		<h2 id="flow-title">{home.process.heading[lang]}</h2>
		<ol class="steps flow">
			{processSteps.map((step) => <li>{step[lang]}</li>)}
		</ol>
		<p class="prose flow-note">{dashboardPage.next.text[lang]}</p>
	</div>
</section>

<script>
	import { filterServices } from '../lib/dashboard-filter.mjs';

	const filters = document.getElementById('dashboard-filters') as HTMLFieldSetElement | null;
	const category = document.getElementById('filter-category') as HTMLSelectElement | null;
	const budget = document.getElementById('filter-budget') as HTMLSelectElement | null;
	const summary = document.getElementById('dashboard-count');
	const empty = document.getElementById('dashboard-empty');
	const reset = document.getElementById('dashboard-reset');
	const nodes = [...document.querySelectorAll<HTMLElement>('[data-service]')];

	if (filters && category && budget && summary && empty && reset && nodes.length) {
		// One record per service, read back from the markup the build already rendered.
		const catalog = [...new Set(nodes.map((node) => node.dataset.service))].map((slug) => {
			const node = nodes.find((item) => item.dataset.service === slug)!;
			return { slug, category: node.dataset.category, startingPriceValue: Number(node.dataset.price) };
		});

		const apply = () => {
			const matched = filterServices(catalog, { category: category.value, maxBudget: budget.value });
			const kept = new Set(matched.map((service) => service.slug));
			// Every representation of a service is hidden together: bars and ledger row.
			for (const node of nodes) node.hidden = !kept.has(node.dataset.service);
			const template = matched.length === 1 ? summary.dataset.one! : summary.dataset.other!;
			summary.textContent = template.replace('{n}', String(matched.length)).replace('{total}', summary.dataset.total!);
			empty.hidden = matched.length > 0;
		};

		category.addEventListener('change', apply);
		budget.addEventListener('change', apply);
		reset.addEventListener('click', () => {
			category.value = 'all';
			budget.value = '';
			apply();
			category.focus();
		});

		// Revealed last: if anything above throws, the static comparison stays and no inert control shows.
		filters.hidden = false;
	}
</script>

<style>
	.eyebrow {
		font-size: var(--text-sm);
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--muted);
		margin-bottom: 0.75rem;
	}

	/* Filters */
	.filters {
		margin: 0;
		padding: 1rem 0 1.5rem;
		border: 0;
		border-top: 2px solid var(--charcoal);
	}

	.filters-legend {
		padding: 0;
		font-family: var(--heading);
		font-size: var(--text-md);
	}

	.field {
		display: flex;
		flex-direction: column;
		gap: 0.375rem;
		max-width: 22rem;
		margin-top: 1rem;
	}

	.field label {
		font-size: var(--text-sm);
		font-weight: 600;
		color: var(--muted);
	}

	select {
		min-height: 2.75rem;
		max-width: 100%;
		padding: 0.5rem 0.75rem;
		border: 2px solid var(--charcoal);
		border-radius: 0;
		background: var(--ivory);
		color: var(--charcoal);
		font: 600 var(--text-base) / 1.25 var(--body);
	}

	@media (min-width: 40rem) {
		.filters {
			display: flex;
			flex-wrap: wrap;
			align-items: end;
			gap: 0 2rem;
		}

		.filters-legend {
			float: left;
			width: 100%;
		}

		.field {
			flex: 1 1 14rem;
		}
	}

	.count {
		margin-top: 1.5rem;
		font-weight: 600;
	}

	/* Comparison figures */
	.figures {
		display: grid;
		gap: 2.5rem;
		margin-top: 2rem;
	}

	.figure figcaption {
		padding-bottom: 0.75rem;
		border-bottom: 2px solid var(--charcoal);
	}

	.figure-note {
		max-width: var(--measure);
		margin-top: 0.5rem;
		font-size: var(--text-sm);
	}

	.bars {
		list-style: none;
	}

	.bar-row {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: center;
		gap: 0.25rem 1rem;
		padding-block: 0.75rem;
		border-bottom: 1px solid var(--rule);
	}

	.bar-name {
		grid-column: 1 / -1;
		font-family: var(--heading);
		font-size: var(--text-md);
		line-height: 1.25;
	}

	.bar-track {
		display: block;
		height: 0.75rem;
		background: var(--paper);
	}

	.bar-fill {
		display: block;
		height: 100%;
		min-width: 3px;
	}

	.bar-price {
		background: var(--vermilion);
	}

	.bar-days {
		background: var(--charcoal);
	}

	.bar-value {
		font-weight: 600;
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}

	/* Two figures fit side by side only once each column still holds a readable name. */
	@media (min-width: 68rem) {
		.figures {
			grid-template-columns: 1fr 1fr;
			gap: 3rem;
		}
	}

	/* Ledger */
	.ledger-title {
		padding-bottom: 0.75rem;
		border-bottom: 2px solid var(--charcoal);
	}

	.ledger {
		list-style: none;
	}

	.ledger-row {
		display: grid;
		gap: 1rem;
		padding-block: 1rem 1.5rem;
		border-bottom: 1px solid var(--rule);
	}

	/* The service name is the row link, so it carries a 44px target of its own. */
	.ledger-head h3 a {
		display: inline-flex;
		align-items: center;
		min-height: 2.75rem;
		text-decoration: none;
	}

	.ledger-head h3 a:hover {
		text-decoration: underline;
	}

	.category {
		margin-top: 0.25rem;
		font-size: var(--text-sm);
		letter-spacing: 0.04em;
		color: var(--muted);
	}

	.ledger-facts {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
		gap: 0.75rem 1.5rem;
	}

	.ledger-facts dt {
		font-size: var(--text-sm);
		color: var(--muted);
	}

	.ledger-facts dd {
		font-weight: 600;
	}

	.fact-price {
		font-variant-numeric: tabular-nums;
	}

	.ledger-details summary {
		display: list-item;
		padding-block: 0.625rem;
		min-height: 2.75rem;
		font-weight: 600;
		cursor: pointer;
	}

	.details-body {
		display: grid;
		gap: 1rem 2rem;
		padding-block: 0.5rem 0.75rem;
	}

	.details-body h4 {
		margin: 0 0 0.375rem;
		font-family: var(--body);
		font-size: var(--text-sm);
		font-weight: 600;
		color: var(--muted);
	}

	@media (min-width: 40rem) {
		.details-body {
			grid-template-columns: 1fr 1fr;
		}
	}

	.ledger-cta {
		justify-self: start;
	}

	@media (min-width: 52rem) {
		.ledger-row {
			grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
			align-items: start;
			column-gap: 3rem;
		}

		.ledger-head {
			grid-column: 1;
			grid-row: 1;
		}

		.ledger-cta {
			grid-column: 1;
			grid-row: 2;
			align-self: start;
		}

		.ledger-facts {
			grid-column: 2;
			grid-row: 1;
		}

		.ledger-details {
			grid-column: 2;
			grid-row: 2;
		}
	}

	.empty {
		max-width: var(--measure);
		margin-top: 2rem;
		padding: 1.5rem;
		background: var(--paper);
	}

	.empty p {
		margin-top: 0.75rem;
	}

	.empty .actions {
		margin-top: 1.25rem;
	}

	.services-link {
		margin-top: 1.5rem;
	}

	.flow {
		display: grid;
		gap: 1.5rem 2.5rem;
		margin-top: 2rem;
	}

	.flow li {
		padding-top: 1rem;
		border-top: 1px solid var(--rule);
	}

	.flow-note {
		margin-top: 2rem;
	}

	@media (min-width: 48rem) {
		.flow {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (min-width: 68rem) {
		.flow {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}
</style>
